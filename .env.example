# ════════════════════════════════════════════════════════════════
#  DETEKTA — Frontend Environment Variables (React / CRA)
#  Copy this file to .env and fill in your own values.
#  ⚠️  Never commit your .env file to version control.
#  ⚠️  All variables MUST be prefixed with REACT_APP_ to be
#      accessible inside the React bundle.
# ════════════════════════════════════════════════════════════════

# ─── API Base URL ─────────────────────────────────────────────────
# URL of the Detekta FastAPI backend (no trailing slash).
# Development default — matches the backend uvicorn default port.
REACT_APP_BACKEND_URL=http://localhost:8000

# Production example:
# REACT_APP_BACKEND_URL=https://api.detekta.io

# ─── Application ──────────────────────────────────────────────────
# Build environment label (informational only, not used for logic).
# development | production | staging
REACT_APP_ENV=development

# ─── Feature Flags (optional) ────────────────────────────────────
# Set to "true" to enable experimental features in the UI.
# REACT_APP_ENABLE_DEEP_SCAN=false
# REACT_APP_ENABLE_MOBILE_AUDIT=true

# ─── Analytics / Monitoring (optional) ───────────────────────────
# Uncomment and fill in if you integrate a third-party analytics tool.
# REACT_APP_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# REACT_APP_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxx
# REACT_APP_POSTHOG_HOST=https://app.posthog.com
